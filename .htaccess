# =====================================================
# Hostinger Apache / LiteSpeed Security & Routing
# =====================================================

# 1. Strictly block sensitive files (.env, .git, .sqlite, .db) from public web access
<FilesMatch "^\.env|^\.git|\.(db|sqlite|log|ini|sh|bat)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 2. Disable directory browsing
Options -Indexes

# 3. Meta WhatsApp Webhook Routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # If Meta verification request hits root / directly (with hub.mode in query string), route to webhook.php
    RewriteCond %{QUERY_STRING} (hub\.mode=subscribe|hub_mode=subscribe) [NC]
    RewriteRule ^$ webhook.php [L,QSA]

    # Route /webhook and /api/webhook directly to webhook.php
    RewriteRule ^webhook/?$ webhook.php [L,QSA]
    RewriteRule ^api/webhook/?$ webhook.php [L,QSA]

    # Route /api/dashboard to api.php for Hostinger native backend
    RewriteRule ^api/dashboard/.*$ api.php [L,QSA]
    RewriteRule ^api/dashboard$ api.php [L,QSA]
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
